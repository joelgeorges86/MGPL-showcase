# MGPL environment-variable inventory.
# Doppler is the canonical source for secrets and runtime configuration. Values are
# intentionally blank EXCEPT the non-secret local defaults / format hints shown inline.

# Runtime and database
NODE_ENV=
PORT=
# DATABASE_URL — canonical SQLite storage config (file: URI). src/db.ts still honors DB_PATH as a path override.
DATABASE_URL=file:./data/mpgl_app.db
CLIENT_ORIGIN=
DB_PATH=
DISABLE_CRON=
RATE_LIMIT_MAX=
MGPL_INTEGRATION_STALE_MS=

# Authentication and encryption
JWT_SECRET=
MGPL_TOKEN_ENC_KEY=
# SESSION_SECRET — canonical session/cookie signer (JWT_SECRET is the legacy auth secret). Minimum 32 chars.
SESSION_SECRET=replace-with-at-least-32-chars-high-entropy-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=

# Storefront and metadata integrations
STEAM_API_KEY=
STEAM_ID=
STEAM_ID64=
ITAD_API_KEY=
OPENCRITIC_API_KEY=
# Canonical Nexus Mods API credential.
NEXUSMODS_API_KEY=
EPIC_OAUTH_TOKEN=
GOG_OAUTH_TOKEN=
GOG_USERNAME=
PSN_NPSSO_CODE=
PSN_NPSSO_TOKEN=
PSN_OAUTH_TOKEN=
XBOX_API_KEY=
UBISOFT_OAUTH_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAMGRIDDB_API_KEY=

# Deals & giveaways API base URLs (safe non-secret defaults)
CHEAPSHARK_BASE_URL=https://www.cheapshark.com/api/1.0
GAMERPOWER_BASE_URL=https://www.gamerpower.com/api

# Observability (Sentry adapter is implemented and tested; activation remains Doppler/configuration-controlled)
SENTRY_DSN=

# Operational limits and checks
CIRCUIT_BREAKER_BACKOFF_MS=
CIRCUIT_BREAKER_FAILURE_THRESHOLD=
CIRCUIT_BREAKER_MAX_BACKOFF_MS=
CIRCUIT_BREAKER_RESET_MS=
DPM_PLAYABILITY_LIMIT=
HW_SCAN_LIMIT=
GATE_BUNDLE_DIST_BYTES=
GATE_BUNDLE_PUBLIC_BYTES=
SMOKE_BASE_URL=
SNAPSHOT_BASE_URL=

# Litestream SQLite replication (Cloudflare R2 primary / Backblaze B2 secondary; injected via Doppler)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
B2_ENDPOINT=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=

# Cloudflare Tunnels & device join (per-environment values, injected via Doppler)
# CLOUDFLARED_TUNNEL_ID — locally-managed tunnel UUID for the environment's cloudflared config.
# CLOUDFLARED_TUNNEL_CREDENTIALS_B64 — base64 of the tunnel credentials JSON (decoded to a root-only 0600 file on the host).
# TAILSCALE_AUTHKEY — reusable pre-auth key used to join the server to the tailnet (tskey-auth-…).
CLOUDFLARED_TUNNEL_ID=
CLOUDFLARED_TUNNEL_CREDENTIALS_B64=
TAILSCALE_AUTHKEY=
