# AI Assistant Workspace Ignore File - Manual v4.0

# Environment variables and secrets
.env
.env.*
*.env

# SQLite and other active databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlitedb

# Dependency directories
node_modules/
package-lock.json

# Compilation and build output targets
dist/
build/
out/
.next/
.nuxt/
.docusaurus/

# Cache directories
.cache/
.parcel-cache/
.eslintcache
.turbo/
.npm/

# Log files and diagnostic snapshots
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System-level artifacts
.DS_Store
Thumbs.db
desktop.ini
