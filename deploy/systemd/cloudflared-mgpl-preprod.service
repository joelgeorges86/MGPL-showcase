# Deployed to: /etc/systemd/system/cloudflared-mgpl-preprod.service
[Unit]
Description=Cloudflare Tunnel client (mgpl-preprod -> preprod.m-gpl.com)
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=15
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/config-preprod.yml tunnel run
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
